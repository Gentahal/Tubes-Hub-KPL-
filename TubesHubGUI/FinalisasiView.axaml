<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TubesHubGUI.FinalisasiView">
    
    <ScrollViewer>
        <Border Background="White" CornerRadius="10" Padding="30" Margin="20"
                BoxShadow="0 4 15 0 #15000000">
            
            <StackPanel Spacing="20">
                <TextBlock Text="Modul Finalisasi Dokumen" FontSize="28" FontWeight="Bold" Foreground="#1E1E1E" />
                <TextBlock Text="Kelola dan pantau status dokumen laporan akhir di sini." Foreground="#666666" FontSize="14" Margin="0,-15,0,10"/>

                <Separator Background="#E0E0E0" Height="1"/>

                <TextBlock Text="Status Dokumen Saat Ini:" FontWeight="SemiBold" FontSize="16" Foreground="#333333"/>
                
                <Border Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="15">
                    <TextBlock x:Name="StatusTextBlock" Text="Memuat..." TextWrapping="Wrap" Foreground="#4A4A4A" FontSize="15" LineHeight="24"/>
                </Border>

                <TextBlock Text="Ubah Status Bab:" FontWeight="SemiBold" FontSize="16" Foreground="#333333" Margin="0,10,0,0"/>
                
                <StackPanel Orientation="Horizontal" Spacing="15">
                    <StackPanel Spacing="5">
                        <TextBlock Text="Pilih Bab" FontSize="12" Foreground="#666666" FontWeight="Medium"/>
                        <ComboBox x:Name="BabComboBox" SelectedIndex="0" Width="180" Background="White" Foreground="Black" BorderBrush="#CCCCCC">
                            <ComboBoxItem>Bab1</ComboBoxItem>
                            <ComboBoxItem>Bab2</ComboBoxItem>
                            <ComboBoxItem>Bab3</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="5">
                        <TextBlock Text="Status Baru" FontSize="12" Foreground="#666666" FontWeight="Medium"/>
                        <ComboBox x:Name="StatusComboBox" SelectedIndex="0" Width="180" Background="White" Foreground="Black" BorderBrush="#CCCCCC">
                            <ComboBoxItem>Draft</ComboBoxItem>
                            <ComboBoxItem>Revisi</ComboBoxItem>
                            <ComboBoxItem>Siap Kumpul</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>

                <Button Content="Simpan Perubahan" Click="OnSimpanClicked" 
                        Background="#0078D7" Foreground="White" FontWeight="Bold"
                        Padding="20,10" CornerRadius="6" HorizontalAlignment="Left" Cursor="Hand"/>

                <TextBlock x:Name="PesanTextBlock" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>