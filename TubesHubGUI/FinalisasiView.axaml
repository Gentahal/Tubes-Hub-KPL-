<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TubesHubGUI.FinalisasiView">
    
    <ScrollViewer>
        <Border Background="White" CornerRadius="10" Padding="30" Margin="20"
                BoxShadow="0 4 15 0 #15000000">
            
            <StackPanel Spacing="20">
                <TextBlock Text="Modul Finalisasi &amp; Laporan" FontSize="28" FontWeight="Bold" Foreground="#1E1E1E" />
                <TextBlock Text="Dasbor rangkuman proyek dan ekspor laporan akhir." Foreground="#666666" FontSize="14" Margin="0,-15,0,10"/>

                <Separator Background="#E0E0E0" Height="1"/>

                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0,10,0,0">
                    <Border Grid.Column="0" Background="#F0F8FF" CornerRadius="8" Padding="20" Margin="0,0,10,10">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Total Tugas" FontSize="14" Foreground="#666666"/>
                            <TextBlock x:Name="TxtTotalTasks" Text="0" FontSize="32" FontWeight="Bold" Foreground="#0078D7"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#F0FFF0" CornerRadius="8" Padding="20" Margin="10,0,0,10">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Tugas Selesai (Done)" FontSize="14" Foreground="#666666"/>
                            <TextBlock x:Name="TxtTasksDone" Text="0" FontSize="32" FontWeight="Bold" Foreground="#28A745"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Total Progres Proyek" FontSize="16" FontWeight="SemiBold" Foreground="#333333"/>
                        <ProgressBar x:Name="ProjectProgressBar" Minimum="0" Maximum="100" Value="0" Height="20" CornerRadius="4" Foreground="#0078D7" Background="#E0E0E0"/>
                        <TextBlock x:Name="TxtProgressPercentage" Text="0% Selesai" FontSize="14" FontWeight="Bold" Foreground="#0078D7" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Border>

                <Border Background="#F8F9FA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Status Dokumen Laporan per Tugas (Automata)" FontSize="16" FontWeight="SemiBold" Foreground="#333333"/>
                        <TextBlock Text="Pilih tugas yang sudah selesai (Done) untuk dikelola dokumen laporannya:" FontSize="13" Foreground="#666666"/>
                        <ComboBox x:Name="CmbTaskFinalisasi" SelectionChanged="CmbTaskFinalisasi_SelectionChanged" HorizontalAlignment="Stretch" Margin="0,5,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:CompileBindings="False">
                                    <TextBlock Text="{Binding Title}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        
                        <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,0">
                            <ComboBox x:Name="CmbDocStatus" Grid.Column="0" HorizontalAlignment="Stretch" Margin="0,0,10,0">
                                <ComboBoxItem Content="Draft"/>
                                <ComboBoxItem Content="Revisi"/>
                                <ComboBoxItem Content="SiapKumpul"/>
                            </ComboBox>
                            <Button Grid.Column="1" Content="Update Status" Click="OnUpdateDocStatusClicked" 
                                    Background="#28A745" Foreground="White" FontWeight="Bold" Padding="15,5" CornerRadius="4" Cursor="Hand"/>
                        </Grid>
                        <TextBlock x:Name="TxtDocStatusInfo" Text="Status saat ini: Draft" FontSize="14" Foreground="#666666" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <Button Content="Generate Laporan Akhir (JSON)" Click="OnGenerateClicked" 
                        Background="#0078D7" Foreground="White" FontWeight="Bold"
                        Padding="20,10" CornerRadius="6" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Cursor="Hand" Margin="0,10,0,0"/>

                <TextBlock x:Name="PesanTextBlock" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>