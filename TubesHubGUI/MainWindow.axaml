<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TubesHubGUI.MainWindow"
        Title="Tubes Hub - Dashboard"
        Width="900" Height="600"
        WindowStartupLocation="CenterScreen">

	<Grid ColumnDefinitions="220, *">
		<Border Grid.Column="0" Background="#2D2D30" Padding="15">
			<StackPanel Spacing="10">
				<TextBlock Text="TUBES HUB" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

				<Button x:Name="BtnWbs" Content="1. WBS" Click="NavWbs_Click" Width="190" Background="#0078D7" Foreground="White" FontWeight="Bold"/>
				<Button x:Name="BtnProgress" Content="2. Progress" Click="NavProgress_Click" Width="190" Background="#3E3E42" Foreground="White" FontWeight="Normal"/>
				<Button x:Name="BtnTeam" Content="3. Team Info" Click="NavTeam_Click" Width="190" Background="#3E3E42" Foreground="White" FontWeight="Normal"/>
				<Button x:Name="BtnScheduler" Content="4. Scheduler" Click="NavScheduler_Click" Width="190" Background="#3E3E42" Foreground="White" FontWeight="Normal"/>
				<Button x:Name="BtnFinalisasi" Content="5. Finalisasi" Click="NavFinalisasi_Click" Width="190" Background="#3E3E42" Foreground="White" FontWeight="Normal"/>
			</StackPanel>
		</Border>

		<Border Grid.Column="1" Background="#F5F5F5">
			<ContentControl x:Name="MainContentArea" Margin="10"/>
		</Border>
	</Grid>

</Window>