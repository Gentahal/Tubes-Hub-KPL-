<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TubesHub.TeamInfoView">

	<Border Margin="20" CornerRadius="12" Background="White" BoxShadow="0 4 10 #10000000">
		<StackPanel Margin="30" Spacing="20">

			<StackPanel Spacing="5">
				<TextBlock Text="Modul Informasi Tim" FontSize="28" FontWeight="Bold" Foreground="#1A1A1A"/>
				<TextBlock Text="Daftar anggota kelompok dan pembagian tugas Tubes Hub." FontSize="14" Foreground="#666666"/>
				<Border Height="1" Background="#E0E0E0" Margin="0,10,0,10"/>
			</StackPanel>

			<TextBlock Text="Anggota Tim Aktif:" FontSize="16" FontWeight="SemiBold" Foreground="#333333"/>

			<ListBox x:Name="LstAnggota" Height="200" CornerRadius="6" BorderBrush="#CCCCCC" BorderThickness="1">
			</ListBox>

			<TextBlock Text="Status Terminal:" FontSize="14" FontWeight="SemiBold" Foreground="#333333" Margin="0,10,0,0"/>
			<Border x:Name="BorderStatus" Background="Gray" CornerRadius="6" Padding="15,10">
				<TextBlock x:Name="LblStatus" Text="Menunggu data..." Foreground="White" FontWeight="Medium" TextWrapping="Wrap"/>
			</Border>

		</StackPanel>
	</Border>
</UserControl>