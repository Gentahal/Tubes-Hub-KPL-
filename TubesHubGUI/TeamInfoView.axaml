<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TubesHubGUI.TeamInfoView">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="15">

            <TextBlock Text="MONITORING TIM" FontSize="22" FontWeight="Bold" Foreground="#1E1E1E"/>
            <TextBlock Text="Data anggota dimuat dari file team.json (Runtime Config). Informasi tugas aktif diambil dari WBS." 
                       Foreground="#666666" FontSize="13" Margin="0,-10,0,0"/>

            <!-- Status bar -->
            <Border x:Name="StatusBar" Background="#E8F5E9" CornerRadius="6" Padding="12,8">
                <TextBlock x:Name="LblStatus" Text="Memuat data..." Foreground="#2E7D32" FontWeight="Medium" FontSize="13"/>
            </Border>

            <!-- Team members cards -->
            <StackPanel x:Name="PnlMembers" Spacing="10"/>

        </StackPanel>
    </ScrollViewer>
</UserControl>