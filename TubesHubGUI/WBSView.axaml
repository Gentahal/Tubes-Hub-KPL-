<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TubesHubGUI.WBSView">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="15">

            <TextBlock Text="WORK BREAKDOWN STRUCTURE (WBS)"
                       FontSize="22" FontWeight="Bold" Foreground="#1E1E1E"/>
            <TextBlock Text="Perencanaan tugas proyek menggunakan teknik Table-Driven Construction." 
                       Foreground="#666666" FontSize="13" Margin="0,-10,0,0"/>

            <!-- Inisialisasi Proyek -->
            <Border Background="White" CornerRadius="8" Padding="20" BoxShadow="0 2 6 0 #18000000">
                <StackPanel Spacing="12">
                    <TextBlock Text="Inisialisasi Proyek" FontWeight="Bold" FontSize="16" Foreground="#333333"/>

                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <TextBlock Grid.Column="0" Text="Bulan Mulai:" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="#555"/>
                        <ComboBox x:Name="CmbStartMonth" Grid.Column="1" HorizontalAlignment="Stretch" Margin="0,0,15,0" SelectedIndex="0">
                            <ComboBoxItem Content="1 - Januari"/>
                            <ComboBoxItem Content="2 - Februari"/>
                            <ComboBoxItem Content="3 - Maret"/>
                            <ComboBoxItem Content="4 - April"/>
                            <ComboBoxItem Content="5 - Mei"/>
                            <ComboBoxItem Content="6 - Juni"/>
                            <ComboBoxItem Content="7 - Juli"/>
                            <ComboBoxItem Content="8 - Agustus"/>
                            <ComboBoxItem Content="9 - September"/>
                            <ComboBoxItem Content="10 - Oktober"/>
                            <ComboBoxItem Content="11 - November"/>
                            <ComboBoxItem Content="12 - Desember"/>
                        </ComboBox>
                        <Button x:Name="BtnInitProject" Grid.Column="2" Content="Inisialisasi Proyek"
                                Padding="15,8" Background="#0078D7" Foreground="White" FontWeight="Bold"
                                CornerRadius="6" Cursor="Hand" Click="BtnInitProject_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Input Tugas Baru -->
            <Border x:Name="PnlInputTask" Background="White" CornerRadius="8" Padding="20" BoxShadow="0 2 6 0 #18000000" IsEnabled="False" Opacity="0.5">
                <StackPanel Spacing="12">
                    <TextBlock Text="Tambah Tugas Baru" FontWeight="Bold" FontSize="16" Foreground="#333333"/>

                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto, *, Auto, *">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Kategori:" VerticalAlignment="Center" Margin="0,0,10,5" Foreground="#555"/>
                        <ComboBox x:Name="CmbCategory" Grid.Row="0" Grid.Column="1" Margin="0,0,15,5" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="UI"/>
                            <ComboBoxItem Content="BACKEND"/>
                            <ComboBoxItem Content="DATABASE"/>
                            <ComboBoxItem Content="DOKUMENTASI"/>
                            <ComboBoxItem Content="TESTING"/>
                        </ComboBox>

                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Judul:" VerticalAlignment="Center" Margin="0,0,10,5" Foreground="#555"/>
                        <TextBox x:Name="TxtTitle" Grid.Row="0" Grid.Column="3" Margin="0,0,0,5"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Deskripsi:" VerticalAlignment="Center" Margin="0,0,10,5" Foreground="#555"/>
                        <TextBox x:Name="TxtDesc" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,5"/>

                        <Button x:Name="BtnAddTask" Grid.Row="2" Grid.Column="3" Content="Tambah Tugas"
                                HorizontalAlignment="Right" Padding="15,8" Margin="0,8,0,0"
                                Background="#28A745" Foreground="White" FontWeight="Bold"
                                CornerRadius="6" Cursor="Hand" Click="BtnAddTask_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Timeline Display -->
            <Border Background="White" CornerRadius="8" Padding="20" BoxShadow="0 2 6 0 #18000000">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Timeline Perencanaan Proyek" FontWeight="Bold" FontSize="16" Margin="0,0,0,10" Foreground="#333333"/>
                    <ScrollViewer MaxHeight="350">
                        <ItemsControl x:Name="TimelinePanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Status -->
            <TextBlock x:Name="TxtStatus" Margin="0,5,0,0" Foreground="DarkGreen" FontStyle="Italic" FontSize="13"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
